# Install this file as /etc/mep/mep.env, then replace every value below.
# Do not commit the real environment file.
MEP_USER=admin
MEP_PASSWORD=replace-with-a-long-unique-password
MEP_SECRET_KEY=replace-with-output-from-openssl-rand-hex-32
MEP_UPLOAD_DIR=/srv/mep/uploads
MEP_DATA_DIR=/srv/mep/data
MEP_RETENTION_DAYS=7
MEP_MAX_UPLOAD_MB=100
MEP_WORKER_POLL_SECONDS=2
PYTHONDONTWRITEBYTECODE=1
