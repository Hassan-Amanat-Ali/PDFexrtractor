[Unit]
Description=MEP Component Extractor Analysis Worker
After=network-online.target mep.service
Wants=network-online.target

[Service]
Type=simple
User=mep
Group=mep
WorkingDirectory=/srv/mep/app
EnvironmentFile=/etc/mep/mep.env
ExecStart=/srv/mep/venv/bin/python /srv/mep/app/analysis_worker.py
Restart=always
RestartSec=2
TimeoutStopSec=20
Nice=10
MemoryHigh=1100M
MemoryMax=1300M
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/srv/mep/data

[Install]
WantedBy=multi-user.target
